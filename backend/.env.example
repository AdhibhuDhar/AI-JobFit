# Copy to .env and fill in. NEVER commit the real .env.
# Written by hand, not generated from a real .env — keep it that way.

# MongoDB connection string. Atlas users: paste the SRV URI here.
# Local: mongodb://127.0.0.1:27017/ai-jobfit
MONGO_URI=

# Port the Express server listens on. Vercel sets this itself; leave blank locally.
PORT=5000

# Google Gemini API key — https://aistudio.google.com/apikey
# Required: without it /analyze and resume parsing will fail.
GEMINI_API_KEY=
